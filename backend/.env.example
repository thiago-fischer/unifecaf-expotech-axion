# Exemplo para o PostgreSQL local iniciado pelo compose da raiz do repositório.
# Exporte a variável no terminal. Não há carregamento automático de .env.
AXION_DATABASE_URL=postgresql+psycopg://axion:axion_local@127.0.0.1:5432/axion
AXION_CAPTURE_TOKEN=
AXION_NETWORK_CAPTURE_ENABLED=false
AXION_NETWORK_EVENT_BUFFER_SIZE=200
AXION_NETWORK_BUCKET_SECONDS=10
AXION_NETWORK_METRICS_RETENTION_HOURS=168
AXION_NETWORK_BATCH_RETENTION_HOURS=24
AXION_GRAFANA_URL=http://127.0.0.1:3000
AXION_GRAFANA_PUBLIC_URL=http://127.0.0.1:3000
AXION_GRAFANA_NETWORK_DASHBOARD_UID=axion-rede-comunicacao
AXION_CONTROLLER_URL=http://127.0.0.1:8001
